# syntax=docker/dockerfile:1.7
FROM python:3.12.10-slim-bookworm@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/rig/src:/ndka/src:/v5/src

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=v5 /manifests/v2_runtime_requirements.lock /opt/nexus/v2-runtime-requirements.lock

RUN python -m pip install \
      --extra-index-url https://download.pytorch.org/whl/cpu \
      -r /opt/nexus/v2-runtime-requirements.lock

# Local fixture runs mount exact Git checkouts at these paths. Docker Desktop can
# present bind-mounted repositories with ownership that differs from the
# container user, so trust only the two fixed donor locations used by the rig.
RUN git config --system --add safe.directory /production \
    && git config --system --add safe.directory /v5 \
    && git config --system --add safe.directory /ndka \
    && git config --system --add safe.directory /rig

WORKDIR /rig

ENTRYPOINT ["python", "-m", "live_runtime_rig"]
